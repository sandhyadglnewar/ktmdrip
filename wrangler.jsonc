{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ktmdrip",
  "compatibility_date": "2025-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "vars": {
    "SITE_NAME": "KTMDrip",
    "SITE_URL": "https://ktmdrip.com",
    "STRIPE_SECRET": "",
    "STRIPE_PUBLIC": ""
  },
  // D1 Database — Products, Users, Orders, Ratings
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ktmdrip",
      "database_id": "1335d31b-abfd-49aa-bdf0-35a37a8cb3cc"
    }
  ],
  // R2 Bucket — Product Images, Media Assets
  // "r2_buckets": [
  //   {
  //     "binding": "R2",
  //     "bucket_name": "ktmdrip-assets"
  //   }
  // ],
  // Local development configuration
  "env": {
    "development": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ktmdrip",
          "database_id": "1335d31b-abfd-49aa-bdf0-35a37a8cb3cc"
        }
      ],

    }
  }
}
